{
  "name": "agent-constella",
  "version": "0.1.0",
  "private": true,
  "description": "Local workflows for human and native coding-agent terminals",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-rebuild -w better-sqlite3,node-pty",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "test": "node scripts/run-tests.mjs",
    "test:graph-ui": "npm run build && electron scripts/check-graph-ui.cjs",
    "test:workflow-ui": "npm run build && electron scripts/check-workflow-ui.cjs",
    "probe:terminal": "npm test -- tests/terminal.test.ts",
    "test:terminal-ui": "npm run build && electron scripts/check-terminal-ui.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
